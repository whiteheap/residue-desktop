{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window. It runs residue only through the app's own commands, each granted here by name (build.rs and commands.rs); it has no shell or file-system permission.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    "allow-app-info",
    "allow-get-settings",
    "allow-set-roots",
    "allow-scan",
    "allow-explain",
    "allow-plan-removal",
    "allow-remove-to-trash",
    "allow-removal-running",
    "allow-wait-for-removal",
    "allow-list-restorable",
    "allow-restore",
    "allow-stats",
    "allow-service-status",
    "allow-service-install",
    "allow-service-uninstall",
    "allow-service-preview"
  ]
}
